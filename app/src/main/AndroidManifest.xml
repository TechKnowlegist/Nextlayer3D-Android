<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No app icon set yet (same placeholder gap as the iOS app's AppIcon) —
         Android falls back to a default launcher icon without one, which
         is fine for this phase; a real icon is a later, cosmetic add. -->
    <application
        android:name=".Nextlayer3DApplication"
        android:allowBackup="true"
        android:label="Nextlayer3D"
        android:theme="@style/Theme.Nextlayer3D">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nextlayer3D">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
